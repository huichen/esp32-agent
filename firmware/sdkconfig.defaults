# esp32-agent defaults for ESP32-S3 (N16R8: 16 MB flash, 8 MB octal PSRAM)
#
# Read only when embuild can find the workspace directory - see CARGO_WORKSPACE_DIR in
# .cargo/config.toml. Once a build has written `sdkconfig` next to this file, that
# file wins: delete it to make an edit here take effect again.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: the octal part on N16R8. Drop these three lines on a board without PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Internal SRAM is what thread stacks and DMA come from, and by default it is also where
# WiFi/lwIP buffers and every allocation below 16 kB live. On this board that left 34 kB
# free and the HTTP server could not spawn a single connection thread (`could not spawn
# connection thread`, and the portal would not open) while 8 MB of PSRAM sat idle.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048

# Room for the HTTP request line and the JSON frames that go over it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_HTTPD_MAX_URI_LEN=512

# Console: the DevKitC-1 carries two USB ports. Primary stays on UART0 (the USB-UART
# bridge, COM3 on the bench, which is what the flashing and monitoring scripts read),
# secondary on the native USB-Serial/JTAG port so either cable shows the log. Do not
# make the JTAG port primary: on the bench machine that silently cuts the console the
# build scripts capture.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# WiFi: needed for both the setup access point and the station link.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# 6 HTTP connections (http.rs MAX_CONNECTIONS) plus the captive DNS socket and slack.
# Slack is not optional: every closed connection sits in TIME_WAIT for 2x TCP_MSL, and
# with 12 sockets the pool ran dry after a few page loads — the portal then "would not
# open" because lwIP had no socket to accept on and reset the new connections.
CONFIG_LWIP_MAX_SOCKETS=20
# 120 s of TIME_WAIT per closed connection is a desktop default; on a LAN with one
# client, 2x5 s is plenty and the slots come back fast.
CONFIG_LWIP_TCP_MSL=5000
# SNTP: the default retry after a failed first attempt is an hour, and until the clock is
# set every https handshake fails (a certificate from 2024 reads as "not yet valid" to a
# board in 1970). A minute is a fair compromise on a LAN that may have no NTP route.
CONFIG_LWIP_SNTP_UPDATE_DELAY=60000
# mbedTLS wants a 16 KB input buffer and a 4 KB output buffer per session. Internal RAM is
# where the radio, the HTTP server and the agent live, and at handshake time only ~17 kB was
# free with a 9 kB largest block: every https:// request failed with a bare ESP_FAIL.
# Those buffers are not DMA memory, so PSRAM is the right home for them.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Partition table from partitions.csv - factory app plus a two-slot OTA rotation with
# the otadata record that selects between them.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

