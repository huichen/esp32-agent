# esp32-agent defaults for ESP32-S3 (N16R8: 16 MB flash, 8 MB octal PSRAM)
#
# Read only when embuild can find the workspace directory - see CARGO_WORKSPACE_DIR in
# .cargo/config.toml. Once a build has written `sdkconfig` next to this file, that
# file wins: delete it to make an edit here take effect again.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: the octal part on N16R8. Drop these three lines on a board without PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Internal SRAM is what thread stacks and DMA come from, and by default it is also where
# WiFi/lwIP buffers and every allocation below 16 kB live. On this board that left 34 kB
# free and the HTTP server could not spawn a single connection thread (`could not spawn
# connection thread`, and the portal would not open) while 8 MB of PSRAM sat idle.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allocations below this threshold always come from internal SRAM. The HTTP server, the
# agent and a TLS handshake all want that same SRAM, and a 30 kB model request squeezed it
# Allocations under 512 B were forced into internal RAM, which is exactly where the
# transcript, the tool registry and the manifest put thousands of small strings. Lowered to 0:
# every allocation may go to PSRAM, and heap_caps falls back to internal when a caller asks
# for caps PSRAM cannot satisfy. The number that forced this is in the boot log: with 512 the
# board reached WiFi init with 84 kB internal free but a largest block of 31 kB, and the radio
# refused to start ("Expected to init 16 rx buffer, actual is 14", then ESP_ERR_NO_MEM) — a
# board that pings nothing and answers nothing, on an image whose own diff was 30 bytes.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# The radio's own static data: lwIP, net80211, pp and wpa_supplicant keep ~18 kB of
# zero-initialized state in `.bss`, and IDF will place those libraries' BSS in PSRAM when
# this is on. It is the one remaining knob that moves *static* internal RAM, and the risk is
# concentrated: this is the same radio whose buffer init failed with "Expected to init 16 rx
# buffer, actual is 14" when small allocations were forced internal. Anything that touches
# WiFi init has to be proved on the bench, not reasoned about: the board runs ten minutes,
# scans once and serves one https request, and `internal_kb` before/after is the evidence.
# If the radio does not come up, this line goes back out.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Room for the HTTP request line and the JSON frames that go over it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_HTTPD_MAX_URI_LEN=512

# Console: the DevKitC-1 carries two USB ports. Primary stays on UART0 (the USB-UART
# bridge, COM3 on the bench, which is what the flashing and monitoring scripts read),
# secondary on the native USB-Serial/JTAG port so either cable shows the log. Do not
# make the JTAG port primary: on the bench machine that silently cuts the console the
# build scripts capture.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# WiFi: needed for both the setup access point and the station link.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# 6 HTTP connections (http.rs MAX_CONNECTIONS) plus the captive DNS socket and slack.
# Slack is not optional: every closed connection sits in TIME_WAIT for 2x TCP_MSL, and
# with 12 sockets the pool ran dry after a few page loads — the portal then "would not
# open" because lwIP had no socket to accept on and reset the new connections.
CONFIG_LWIP_MAX_SOCKETS=20
# 120 s of TIME_WAIT per closed connection is a desktop default; on a LAN with one
# client, 2x5 s is plenty and the slots come back fast.
CONFIG_LWIP_TCP_MSL=5000
# SNTP: the default retry after a failed first attempt is one hour, and until the clock is
# set every https handshake fails (certificates from 2024 read as "not yet valid" to a
# board in 1970). A minute is a fair compromise on a LAN that may have no NTP route.
CONFIG_LWIP_SNTP_UPDATE_DELAY=60000
# mbedTLS wants a 16 KB input buffer and a 4 KB output buffer per session. Internal RAM is
# where the radio, the HTTP server and the agent live, and at handshake time only ~17 kB was
# free with a 9 kB largest block: every https:// request failed with a bare ESP_FAIL.
# Those buffers are not DMA memory, so PSRAM is the right home for them.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# https on the board itself: esp-tls needs the server role, and the certificate it serves
# is generated on first boot — which needs mbedTLS' X.509 writer and PEM output compiled in.
# Without these three the firmware still builds and http still works; https is simply
# absent, and `/api/tls` says so.
CONFIG_ESP_TLS_SERVER=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
# Hardware AES-DMA needs a DMA-capable buffer in internal RAM, and on this board the TLS
# connection thread runs with ~14 kB of internal RAM left: the first record failed with
# `esp-aes: Failed to allocate memory` and every https write died with ESP_FAIL. Software
# AES is a few milliseconds per kilobyte, which for a portal and a 30 kB model request is
# not worth the internal RAM. The handshake itself succeeded either way.
CONFIG_MBEDTLS_HARDWARE_AES=n

# Partition table from partitions.csv - factory app plus a two-slot OTA rotation with
# the otadata record that selects between them.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS task introspection for \shell ps\: uxTaskGetSystemState is compiled out
# unless the trace facility is on, and with it off the linker fails on the symbol.
# It costs a few bytes per task.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Thread stacks on this board must be allowed to come from PSRAM: internal SRAM is down
# to a few kB after TLS, and a request thread that cannot get a stack turns a slow request
# into no requests at all.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# A TLS record buffer is 16 KB by default in each direction; the board answers with a
# few kilobytes at a time and handshakes while internal SRAM is nearly gone. 4 KB is the
# smallest that still carries a normal response, and it frees ~24 KB in one step.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
